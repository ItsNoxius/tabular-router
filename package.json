{
  "name": "tabular-router",
  "version": "0.1.0",
  "description": "SolidJS tabbed router with per-tab history and entry-local state",
  "keywords": [
    "router",
    "solidjs",
    "tabs"
  ],
  "homepage": "https://github.com/ItsNoxius/tabular-router#readme",
  "bugs": {
    "url": "https://github.com/ItsNoxius/tabular-router/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsNoxius/tabular-router.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./persist": {
      "types": "./dist/persist.d.ts",
      "import": "./dist/persist.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "esbuild-plugin-solid": "^0.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.65.0",
    "solid-js": "^1.9.12",
    "tsup": "^8.5.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts,tsx,mjs,cjs}": "oxlint --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.1.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

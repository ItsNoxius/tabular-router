{
  "name": "tabular-router",
  "version": "0.1.0",
  "description": "SolidJS tabbed router with per-tab history and entry-local state",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "packageManager": "pnpm@11.1.1",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./persist": {
      "types": "./dist/persist.d.ts",
      "import": "./dist/persist.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsNoxius/tabular-router.git"
  },
  "bugs": {
    "url": "https://github.com/ItsNoxius/tabular-router/issues"
  },
  "homepage": "https://github.com/ItsNoxius/tabular-router#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "solidjs",
    "router",
    "tabs"
  ],
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "^1.9.12",
    "tsup": "^8.5.0",
    "typescript": "~6.0.3"
  }
}
